<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Tax Return Payment Summary</masterLabel>
    <description>Premium Tax Fees &amp; Payment summary for FCNB_Premium Tax Return OmniScript. Shows Context, Return ID, Payment status, Amount due from Omni JSON.</description>
    <runtimeNamespace>omnistudio</runtimeNamespace>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage,lightningCommunity__Default">
            <property name="payeeName" type="String" label="Payee Name" description="Cheque alternate payee text"/>
            <property name="paymentNotice" type="String" label="Payment Notice" description="Notice under Pay online"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>