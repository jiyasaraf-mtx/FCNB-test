<apex:page renderAs="pdf" controller="LPI_LicenseIssuedContoller" applyBodyTag="false" applyHtmlTag="false" showHeader="false" standardstylesheets="false" contentType="text/html;charset=UTF-8">
    <head>
        <style>
            body {
                font-family: Arial Unicode MS;
            }

            font { font-family: Arial Unicode MS !important; }

            table {
                width: 100%;
                table-layout:fixed;
            }

            table tr {
                page-break-inside: avoid;
            }

            table td {
                vertical-align: baseline;
            }

            .custom-grid-3 td {
                width: 33%;
                padding-bottom: 20px;
                padding-right: 10px;
            }

            .custom-grid-2 td {
                width: 50%;
                padding-bottom: 20px;
                padding-right: 10px;
            }

            .custom-grid-1 td {
                width: 100%;
                padding-bottom: 20px;
                padding-right: 10px;
            }

            .section{
                margin-top: 20px;
            }

            .section .sectionHeading{
                font-weight: 500;
                font-size: 16px;
                color: #1E3A62;
            }

            .subSection .sectionHeading{
                font-weight: 500;
                font-size: 16px;
                color: #1E3A62;
            }

            .regularSectionHeading{
                font-size: 15px !important;
                font-weight: 900;
                color: black !important;
            }

            .headingLine{
                border: 1px solid #D4D4D4;
            }

            .sectionBody{
                padding-top: 15px;
            }

            .view-info-label{
                font-size: 12px;
                color: #6B6B6B;
                word-wrap:break-word !important;

            }

            .read-only-info{
                font-size: 14px;
                color: #121212;
                overflow-wrap: break-word !important;
                word-wrap: break-word !important;
            }

            .bold-regular-text{
                font-size: 12px !important;
                color: #6B6B6B !important;
            }


            .sectionBody .main-question{
                padding-bottom: 20px;
                padding-right: 10px;
            }

            .bold-heading{
                font-size: 15px !important;
                font-weight: 900;
                color: black !important;
            }
            .pdf-image-logo{
                margin: 40px;
            }
            .color-blue{
                color: #1E3A62;
            }

            .page-heading{
                font-size: 26px;
                line-height: 30px;
            }

            .pdfBody{
                position: relative;
            }
            .sectionBody{
                margin: auto auto;
            }
            .watermark{
                position: absolute;
                top: 30%;
                left: 15%;
                width: 70%;
                text-align: center;
                opacity: 0.35;
            }

            .labelClass h1,.labelClass h2,.labelClass h3,.labelClass h4{
                font-size: 16px;
                color: #121212;
            }
            .labelClass p,.labelClass ol,.labelClass li{
                font-size: 14px;
                color: #121212;
            }
            .labelClass strong{
                font-size: 14px !important;
                font-weight: bold;
                color: black !important;
                font-family: sans-serif;
            }
            .review{
                border: 1px solid #D4D4D4;
                padding: 1rem;
                border-radius: 4px;
            }
            h3{
                color: #0f3d54;
                width: 100%;
                text-align: left;
                font-weight: 600;
            }
    .width-33{
            width:33.33%
            }
            table tr td{padding-bottom:1rem}
            table{
            padding:20px;
            }
            
            
        </style>
    </head>
    <body>
        <div class="pdf">
               <div class="pdfheader">
                <c:LPI_PDFLogo />
                <hr/>
            </div>
            <div class="pdfBody">
            <div class="watermark">
                <apex:image value="{!URLFOR($Resource.LPI_IBM_Logo_Watermark)}" width="500" height="500" alt=""/>
            </div>
            <h3>
                License
            </h3>
            <apex:outputPanel rendered="{!NOT(ISNULL(ia))}">
            <div class="review">
                <table>
                    <tr>
                    <td>
                         <div class="label">
                    License Type
                    </div>
                     <div class="label-value">
                        {!ia.LicenseType.Name}
                    </div> </td>
                          <td>
                         <div class="label">
                    License Number
                    </div>
                     <div class="label-value">
                        {!ia.LicensePermitName.Name}
                    </div> </td>
                          <td>
                         <div class="label">
                    License Type
                    </div>
                     <div class="label-value">
                        {!ia.LicensePermitName.Status}
                    </div> </td>
                    </tr>
         
                </table>
            </div>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!NOT(ISNULL(bla))}">
            <div class="review">
                <table>
                    <tr>
                    <td>
                         <div class="label">
                    License Type
                    </div>
                     <div class="label-value">
                        {!bla.LicenseType.Name}
                    </div> </td>
                          <td>
                         <div class="label">
                    License Number
                    </div>
                     <div class="label-value">
                        {!bla.LicensePermitName.Name}
                    </div> </td>
                          <td>
                         <div class="label">
                    License Type
                    </div>
                     <div class="label-value">
                        {!bla.LicensePermitName.Status}
                    </div> </td>
                    </tr>
         
                </table>
            </div>
            </apex:outputPanel>
        </div>
        </div>
    </body>
</apex:page>