<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,force:hasRecordId,force:hasSObjectName">
  <aura:html tag="style">
      .slds-modal__container{
        min-width: 55rem !important; 
      }
      .slds-modal__close.closeIcon { 
        display: none;
      }
  </aura:html>
  <c:lpiApplicationDocumentDeficiencyNotice recordId ="{!v.recordId}" objectApiName ="{!v.sObjectName}" onmodalclose="{!c.handleClose}"/>
</aura:component>